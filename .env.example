# En local : `npx supabase start`, puis `npm run env:local` génère .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clé secrète (contourne la RLS) : les tests et les tâches planifiées, jamais exposée au navigateur.
SUPABASE_SECRET_KEY=sb_secret_...

# Mailpit, qui intercepte les emails du Supabase local, et ceux de l'app quand RESEND_API_KEY est vide.
MAILPIT_URL=http://127.0.0.1:54324

# Secret des tâches planifiées (/api/cron/*) : Vercel l'envoie dans `Authorization: Bearer …`.
# En local et en CI, `npm run env:local` écrit une valeur fixe.
CRON_SECRET=cron-local

# Webhook Stripe (/api/webhooks/stripe) : le secret de signature de l'endpoint, whsec_… (Dashboard Stripe).
# En local et en CI, `npm run env:local` écrit une valeur fixe, avec laquelle les tests signent leurs événements.
# Ne le mets jamais dans .env.development.local : il y masquerait cette valeur (recette : docs/DEPLOIEMENT.md).
STRIPE_WEBHOOK_SECRET=whsec_local

# Paiement Stripe (Checkout, portail client), facultatif en local : sans clé, « Passer en Pro » est indisponible.
# À mettre dans .env.development.local, comme la clé d'API Claude : `next dev` et `npm run stripe:config` le lisent.
# STRIPE_SECRET_KEY=sk_test_...

# Emails de l'app (alertes, factures) par Resend : en production seulement. Sans clé, ils arrivent dans Mailpit.
# RESEND_API_KEY=re_...

# Relève Gmail (Composio), facultative en local : sans clé, « Connecter Gmail » est indisponible, et les tests simulent
# Composio avec des événements signés. La clé de projet et l'auth config Gmail (`npm run composio -- config`) vont dans
# .env.development.local, comme la clé Stripe.
# COMPOSIO_API_KEY=ak_...
# COMPOSIO_AUTH_CONFIG_GMAIL=ac_...

# Rappels Google Calendar (Composio), facultatifs en local : sans auth config de l'agenda, « Connecter Google Calendar »
# est indisponible et aucune synchronisation ne part ; les tests simulent l'agenda. La même clé de projet, et l'auth
# config de l'agenda (`npm run composio -- config-agenda`), vont dans .env.development.local.
# COMPOSIO_AUTH_CONFIG_AGENDA=ac_...

# Webhook Composio (/api/webhooks/composio) : le secret de l'abonnement webhook du projet Composio.
# En local et en CI, `npm run env:local` écrit une valeur fixe, avec laquelle les tests signent leurs événements.
# Ne le mets jamais dans .env.development.local : il y masquerait cette valeur (recette : docs/DEPLOIEMENT.md).
COMPOSIO_WEBHOOK_SECRET=composio-local

# Lecture IA des avis (API Claude), facultative en local : sans clé, l'avis se saisit à la main.
# À mettre dans .env.development.local, que `npm run env:local` n'écrase pas : `next dev` et
# `npm run eval:lecture` le lisent, les tests unitaires et d'intégration non.
ANTHROPIC_API_KEY=sk-ant-...
