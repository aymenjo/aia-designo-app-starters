# En local : `npx supabase start`, puis `npm run env:local` génère .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clé secrète (contourne la RLS) : tests uniquement en phase 1, jamais exposée au navigateur.
SUPABASE_SECRET_KEY=sb_secret_...

# Mailpit, qui intercepte les emails du Supabase local (tests E2E).
MAILPIT_URL=http://127.0.0.1:54324
