# En local : `npx supabase start`, puis `npm run env:local` génère .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clé secrète (contourne la RLS) : les tests et les tâches planifiées, jamais exposée au navigateur.
SUPABASE_SECRET_KEY=sb_secret_...

# Mailpit, qui intercepte les emails du Supabase local, et ceux de l'app quand RESEND_API_KEY est vide.
MAILPIT_URL=http://127.0.0.1:54324

# Secret des tâches planifiées (/api/cron/*) : Vercel l'envoie dans `Authorization: Bearer …`.
# En local et en CI, `npm run env:local` écrit une valeur fixe.
CRON_SECRET=cron-local

# Emails de l'app (alertes) par Resend : en production seulement. Sans clé, ils arrivent dans Mailpit.
# RESEND_API_KEY=re_...

# Lecture IA des avis (API Claude), facultative en local : sans clé, l'avis se saisit à la main.
# À mettre dans .env.development.local, que `npm run env:local` n'écrase pas : `next dev` et
# `npm run eval:lecture` le lisent, les tests unitaires et d'intégration non.
ANTHROPIC_API_KEY=sk-ant-...
