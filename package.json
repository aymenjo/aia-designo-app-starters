{
  "name": "designo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "eval:lecture": "vitest run --project evaluation",
    "env:local": "scripts/env-supabase-local.sh > .env.local",
    "stripe:config": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.development.local scripts/stripe-config.mts",
    "composio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.development.local scripts/composio-essai.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@composio/core": "0.27.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "heic-to": "^1.6.6",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@next/env": "^16.4.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
